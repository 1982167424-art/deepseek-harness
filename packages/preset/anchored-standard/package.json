{
  "name": "@deepseek-ai/dsh-preset-anchored-standard",
  "description": "Anchored-Standard experimental agent presets: Minimal-trajectory bootstrap + Standard catalog via the tool-search pattern (anchored, zero-anchored, whoami variants).",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/anchored-standard"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/preset/**/*.mjs",
    "lib/preset/*.yml",
    "lib/zero-anchored-standard/**/*.mjs",
    "lib/zero-anchored-standard/*.yml",
    "lib/whoami-standard/**/*.mjs",
    "lib/whoami-standard/*.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^"
  }
}
